# AI provider configuration
AI_PROVIDER=azure
AI_FALLBACK_PROVIDERS=openai,ollama,mock
AI_ENDPOINT=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=30000

# Azure OpenAI / DeepSeek
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-03-15-preview

# OpenAI-compatible provider
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# OpenRouter provider
OPENROUTER_API_URL=https://openrouter.ai/v1
OPENROUTER_API_KEY=

# Local Ollama
OLLAMA_URL=http://localhost:11434

# Custom OpenAI-compatible endpoint
CUSTOM_OPENAI_API_URL=
CUSTOM_OPENAI_API_KEY=

# SMTP / notification configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@haloitservices365.co.za

# Backend runtime configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=halo-dev-secret-key-change-in-production
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
